package templates

import (
	"ScrumBoard/internal/models"
	"encoding/json"
	"fmt"
	"strings"
)

// SMStatCard is a simple stat card for scrum master dashboard
templ SMStatCard(icon, title, value, colorClass string) {
	<div class={ "glass rounded-2xl p-6 card-hover animate-scale-in shadow-lg " + colorClass }>
		<div class="flex items-center gap-4">
			<div class="text-3xl">{ icon }</div>
			<div>
				<p class="text-sm font-semibold text-white uppercase tracking-wide">{ title }</p>
				<p class="text-2xl font-extrabold text-white">{ value }</p>
			</div>
		</div>
	</div>
}

templ ScrumMasterDashboard(data models.ScrumMasterDashboardData) {
	@Layout("Scrum Master Dashboard") {
		<div class="min-h-screen">
			<!-- Header -->
			<header class="bg-slate-900/80 backdrop-blur-lg text-white py-6 px-8 shadow-xl border-b border-slate-700/50">
				<div class="w-full flex items-center justify-between">
					<div class="flex items-center gap-4">
						<div class="w-12 h-12 bg-slate-800/80 rounded-xl flex items-center justify-center text-2xl shadow-xl">
							👨‍💼
						</div>
						<div>
							<h1 class="text-2xl font-bold text-white">Scrum Master Dashboard</h1>
							<p class="text-white/70 text-sm">Team Health & Sprint Analytics</p>
						</div>
					</div>
					<div class="flex items-center gap-4">
						<!-- Sprint Selector -->
						<div class="glass-dark px-4 py-2 rounded-xl">
							<p class="text-xs text-white/70 mb-1">Sprint</p>
							<select id="sprint-selector" class="bg-white/10 text-white border border-white/20 rounded-lg px-3 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-white/30">
								<option value="0">Loading...</option>
							</select>
						</div>
						<!-- Jira Link -->
						<a id="jira-sprint-link" href="#" target="_blank" class="bg-blue-500/80 hover:bg-blue-600/90 px-4 py-2 rounded-xl transition-all flex items-center gap-2" title="Open in Jira">
							<span>🔗</span>
							<span class="hidden sm:inline">Jira</span>
						</a>
						<a href="/" class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-lg text-sm font-semibold transition backdrop-blur">
							🏠 Home
						</a>
						<a href="/sprint" class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-lg text-sm font-semibold transition backdrop-blur">
							📊 Sprint
						</a>
					</div>
				</div>
			</header>

			<!-- Dashboard Content -->
			<main id="dashboard-content" class="w-full px-6 py-8">
				@ScrumMasterDashboardContent(data)
			</main>
		</div>

		<!-- Sprint Selection Script -->
		<script>
			const jiraBaseUrl = 'https://jira-eng-gpk1.cisco.com/jira';
			const urlParams = new URLSearchParams(window.location.search);
			const currentSprintId = parseInt(urlParams.get('sprint') || '0');

			// Update Jira link
			function updateJiraLink(sprintId) {
				const jiraLink = document.getElementById('jira-sprint-link');
				if (sprintId && sprintId !== '0') {
					jiraLink.href = `${jiraBaseUrl}/secure/RapidBoard.jspa?rapidView=6991&sprint=${sprintId}`;
				} else {
					jiraLink.href = `${jiraBaseUrl}/secure/RapidBoard.jspa?rapidView=6991`;
				}
			}

			// Set initial Jira link
			updateJiraLink(currentSprintId);

			// Load sprints
			fetch('/api/sprints')
				.then(res => res.json())
				.then(sprints => {
					const selector = document.getElementById('sprint-selector');
					selector.innerHTML = '<option value="0">🟢 Active Sprint</option>';

					sprints.sort((a, b) => b.id - a.id).forEach(sprint => {
						const option = document.createElement('option');
						option.value = sprint.id;
						const stateEmoji = sprint.state === 'active' ? '🟢' : '🔴';
						option.textContent = `${stateEmoji} ${sprint.name}`;
						if (sprint.id === currentSprintId) option.selected = true;
						selector.appendChild(option);
					});
				});

			// Handle sprint change
			document.getElementById('sprint-selector').addEventListener('change', function() {
				const sprintId = this.value;
				updateJiraLink(sprintId);
				window.location.href = `/scrum-master?sprint=${sprintId}`;
			});
		</script>
	}
}

templ ScrumMasterDashboardContent(data models.ScrumMasterDashboardData) {
	<!-- Sprint Info & Health Score -->
	<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
		@SMStatCard("📅", "Sprint", data.Sprint.Name, "bg-gradient-to-br from-blue-500 to-blue-600")
		@SMStatCard("💪", "Health Score", fmt.Sprintf("%d%%", data.TeamHealth.OverallScore), getHealthColor(data.TeamHealth.HealthStatus))
		@SMStatCard("🚀", "Velocity", fmt.Sprintf("%d pts", data.VelocityData.CurrentVelocity), "bg-gradient-to-br from-purple-500 to-purple-600")
		@SMStatCard("⚠️", "Risks", fmt.Sprintf("%d", len(data.RiskIndicators)), getRiskColor(len(data.RiskIndicators)))
	</div>

	<!-- Velocity & Burndown Charts -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
		@VelocityChart(data.VelocityData)
		@BurndownChart(data.TeamHealth.SprintBurndown, data.Stats.TotalPoints)
	</div>

	<!-- Team Capacity & Risk Indicators -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
		@TeamCapacityCard(data.UserStats, data.TeamHealth, data.Sprint.Name)
		@RiskIndicatorsCard(data.RiskIndicators)
	</div>

	<!-- Sprint History & Blockers -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
		@SprintHistoryCard(data.SprintHistory)
		@BlockersCard(data.Blockers)
	</div>


	<!-- At-Risk Prediction Section -->
	<div class="glass rounded-2xl p-6 card-hover animate-fade-in mb-8">
		<h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
			<span class="text-2xl">🔮</span>
			<span>Sprint Completion Prediction</span>
			<div class="ml-auto flex gap-2">
				<button onclick="analyzeRisks()" class="px-3 py-1 bg-purple-500 hover:bg-purple-600 text-white text-xs font-semibold rounded-lg transition-all">
					🔍 Analyze
				</button>
				<button id="alert-risk-btn" onclick="sendRiskAlerts()" class="px-3 py-1 bg-orange-500 hover:bg-orange-600 text-white text-xs font-semibold rounded-lg transition-all hidden">
					📣 Alert All via Webex
				</button>
			</div>
		</h3>
		<p class="text-sm text-cyan-200 mb-4">AI predicts which stories/bugs may not complete before sprint ends based on status, days left, and activity.</p>
		<div id="risk-prediction-list" class="space-y-3 max-h-96 overflow-y-auto">
			<p class="text-cyan-200 text-center py-4">Click "Analyze" to check for at-risk items...</p>
		</div>
	</div>

	<!-- Info Requests Section -->
	<div class="glass rounded-2xl p-6 card-hover animate-fade-in mb-8">
		<h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
			<span class="text-2xl">�</span>
			<span>Info Requests & Responses</span>
			<button onclick="loadAllInfoRequests()" class="ml-auto px-3 py-1 bg-blue-500 hover:bg-blue-600 text-white text-xs font-semibold rounded-lg transition-all">
				🔄 Refresh
			</button>
		</h3>
		<div id="info-request-list" class="space-y-3 max-h-96 overflow-y-auto">
			<p class="text-cyan-200 text-center py-4">Loading info requests...</p>
		</div>
	</div>

	<script>
		function loadAllInfoRequests() {
			fetch('/engineer/api/pings')
				.then(function(res) { return res.json(); })
				.then(function(data) {
					var reqList = document.getElementById('info-request-list');
					if (!reqList) return;

					if (!data.pings || data.pings.length === 0) {
						reqList.innerHTML = '<p class="text-cyan-200 text-center py-4">No info requests yet. Use "Request Info" button on stories/defects.</p>';
						return;
					}

					reqList.innerHTML = data.pings.map(function(ping) {
						var borderClass = ping.status === 'responded' ? 'border-green-300 bg-green-50' : 'border-yellow-300 bg-yellow-50';
						var statusClass = ping.status === 'responded' ? 'bg-green-500/30 text-green-300' : 'bg-yellow-500/30 text-yellow-300';
						var statusText = ping.status === 'responded' ? '✅ Responded' : '⏳ Awaiting Reply';
						var responseHtml = '';
						if (ping.response) {
							responseHtml = '<div class="mt-3 bg-green-500/20 rounded-lg p-3 border border-green-400/50">' +
								'<p class="text-xs text-green-300 mb-1">📩 Response (' + ping.responded_at + '):</p>' +
								'<p class="text-sm text-green-200 font-medium">' + ping.response + '</p></div>';
						}
						var itemHtml = ping.item_key ? '<p class="text-sm font-bold text-blue-300 mb-1">🎯 ' + ping.item_key + ': ' + (ping.item_title || '') + '</p>' : '';
						return '<div class="rounded-xl p-4 border-2 ' + borderClass + '">' +
							'<div class="flex items-center justify-between mb-2">' +
							'<div class="flex items-center gap-2">' +
							'<span class="font-bold text-white">' + ping.engineer_name + '</span>' +
							'<span class="text-xs text-cyan-200">(' + ping.engineer_email + ')</span></div>' +
							'<span class="px-2 py-1 rounded-full text-xs font-semibold ' + statusClass + '">' + statusText + '</span></div>' +
							itemHtml +
							'<div class="flex items-center gap-4 text-xs text-cyan-200 mb-2">' +
							'<span>📤 Requested: ' + ping.sent_at + '</span>' +
							'<span>🏃 Sprint: ' + ping.sprint_name + '</span></div>' +
							responseHtml + '</div>';
					}).join('');
				})
				.catch(function(err) {
					console.error('Error loading info requests:', err);
					document.getElementById('info-request-list').innerHTML = '<p class="text-red-500 text-center py-4">Error loading info requests</p>';
				});
		}

		// Load info requests on page load
		loadAllInfoRequests();

		// Risk prediction functions
		function analyzeRisks() {
			var riskList = document.getElementById('risk-prediction-list');
			riskList.innerHTML = '<p class="text-cyan-200 text-center py-4">🔄 Analyzing sprint risks...</p>';

			var sprintId = document.getElementById('sprint-selector').value || '0';
			fetch('/api/risk/items?sprint=' + sprintId)
				.then(function(res) { return res.json(); })
				.then(function(data) {
					if (!data.risks || data.risks.length === 0) {
						riskList.innerHTML = '<div class="text-center py-8"><div class="text-4xl mb-2">✅</div><div class="text-green-300 font-semibold">All items on track!</div><div class="text-cyan-200 text-sm">No items predicted to miss sprint completion.</div></div>';
						document.getElementById('alert-risk-btn').classList.add('hidden');
						return;
					}

					document.getElementById('alert-risk-btn').classList.remove('hidden');

					riskList.innerHTML = data.risks.map(function(risk) {
						var riskColor = risk.riskLevel === 'high' ? 'border-red-400 bg-red-500/20' : 'border-yellow-400 bg-yellow-500/20';
						var riskBadge = risk.riskLevel === 'high' ? 'bg-red-500 text-white' : 'bg-yellow-500 text-white';
						var typeEmoji = risk.type === 'story' ? '📖' : '🐛';
						return '<div class="rounded-xl p-4 border-2 ' + riskColor + '">' +
							'<div class="flex items-center justify-between mb-2">' +
							'<div class="flex items-center gap-2">' +
							'<span class="text-lg">' + typeEmoji + '</span>' +
							'<span class="font-bold text-white">' + risk.key + '</span>' +
							'<span class="px-2 py-0.5 rounded text-xs font-bold ' + riskBadge + '">' + risk.riskLevel.toUpperCase() + '</span>' +
							'</div>' +
							'<span class="text-xs text-cyan-200">⏰ ' + risk.daysLeft + ' days left</span>' +
							'</div>' +
							'<p class="text-sm text-white mb-1">' + risk.title + '</p>' +
							'<div class="flex items-center gap-4 text-xs">' +
							'<span class="text-orange-300">⚠️ ' + risk.reason + '</span>' +
							'<span class="text-cyan-200">👤 ' + (risk.assignee || 'Unassigned') + '</span>' +
							'</div>' +
							'</div>';
					}).join('');
				})
				.catch(function(err) {
					console.error('Error analyzing risks:', err);
					riskList.innerHTML = '<p class="text-red-500 text-center py-4">Error analyzing risks</p>';
				});
		}

		function sendRiskAlerts() {
			if (!confirm('Send Webex alerts to all assignees of at-risk items?')) return;

			var alertBtn = document.getElementById('alert-risk-btn');
			alertBtn.textContent = '⏳ Sending...';
			alertBtn.disabled = true;

			var sprintId = document.getElementById('sprint-selector').value || '0';
			var formData = new FormData();
			formData.append('sprint', sprintId);

			fetch('/api/risk/alert', {
				method: 'POST',
				body: formData
			})
				.then(function(res) { return res.json(); })
				.then(function(data) {
					alertBtn.textContent = '📣 Alert All via Webex';
					alertBtn.disabled = false;

					if (data.success) {
						alert('✅ Sent ' + data.sent + ' of ' + data.total + ' alerts successfully!');
					} else {
						alert('❌ Failed: ' + data.message);
					}
				})
				.catch(function(err) {
					alertBtn.textContent = '📣 Alert All via Webex';
					alertBtn.disabled = false;
					alert('❌ Error sending alerts');
				});
		}
	</script>
}

// VelocityChart shows team velocity over sprints
templ VelocityChart(velocity models.VelocityData) {
	<div class="glass rounded-2xl p-6 card-hover animate-fade-in" data-velocity={ marshalVelocityData(velocity) }>
		<div class="flex items-center justify-between mb-4">
			<h3 class="text-lg font-bold text-white flex items-center gap-2">
				<span class="text-2xl">📈</span>
				<span>Team Velocity</span>
			</h3>
			<div class={ "px-3 py-1 rounded-full text-sm font-bold " + getVelocityTrendClass(velocity.VelocityTrend) }>
				{ getVelocityTrendIcon(velocity.VelocityTrend) } { velocity.VelocityTrend }
			</div>
		</div>
		<div class="grid grid-cols-3 gap-4 mb-4 text-center">
			<div class="bg-blue-500/20 rounded-lg p-3 border border-blue-400/30">
				<div class="text-2xl font-bold text-blue-300">{ fmt.Sprintf("%d", velocity.CurrentVelocity) }</div>
				<div class="text-xs text-cyan-200">Current</div>
			</div>
			<div class="bg-green-500/20 rounded-lg p-3 border border-green-400/30">
				<div class="text-2xl font-bold text-green-300">{ fmt.Sprintf("%d", velocity.AverageVelocity) }</div>
				<div class="text-xs text-cyan-200">Average</div>
			</div>
			<div class="bg-purple-500/20 rounded-lg p-3 border border-purple-400/30">
				<div class="text-2xl font-bold text-purple-300">{ fmt.Sprintf("%d", velocity.PredictedNext) }</div>
				<div class="text-xs text-cyan-200">Predicted</div>
			</div>
		</div>
		<div class="chart-container h-64">
			<canvas id="velocityChart"></canvas>
		</div>
	</div>
	<script type="text/javascript">
		(function() {
			const div = document.querySelector('[data-velocity]');
			if (!div) return;
			const velocity = JSON.parse(div.getAttribute('data-velocity'));
			const ctx = document.getElementById('velocityChart');
			if (!ctx || !velocity.sprintVelocities) return;

			const labels = velocity.sprintVelocities.map(v => v.sprintName.replace('NM-', '')).reverse();
			const committed = velocity.sprintVelocities.map(v => v.committed).reverse();
			const completed = velocity.sprintVelocities.map(v => v.completed).reverse();

			new Chart(ctx.getContext('2d'), {
				type: 'bar',
				data: {
					labels: labels,
					datasets: [
						{ label: 'Committed', data: committed, backgroundColor: 'rgba(59,130,246,0.7)', borderRadius: 8 },
						{ label: 'Completed', data: completed, backgroundColor: 'rgba(16,185,129,0.7)', borderRadius: 8 }
					]
				},
				options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: { position: 'top', labels: { color: '#fff' } }
						},
						scales: {
							x: { ticks: { color: '#fff' }, grid: { color: 'rgba(255,255,255,0.1)' } },
							y: { ticks: { color: '#fff' }, grid: { color: 'rgba(255,255,255,0.1)' } }
						}
					}
			});
		})();
	</script>
}

// BurndownChart shows sprint burndown
templ BurndownChart(burndown []models.BurndownPoint, totalPoints int) {
	<div class="glass rounded-2xl p-6 card-hover animate-fade-in" data-burndown={ marshalBurndownData(burndown) } data-total={ fmt.Sprintf("%d", totalPoints) }>
		<h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
			<span class="text-2xl">🔥</span>
			<span>Sprint Burndown</span>
		</h3>
		<div class="chart-container h-64">
			<canvas id="burndownChart"></canvas>
		</div>
	</div>
	<script type="text/javascript">
		(function() {
			const div = document.querySelector('[data-burndown]');
			if (!div) return;
			const burndown = JSON.parse(div.getAttribute('data-burndown'));
			const ctx = document.getElementById('burndownChart');
			if (!ctx || !burndown) return;

			const labels = burndown.map(b => b.date);
			const actual = burndown.map(b => b.remainingPoints);
			const ideal = burndown.map(b => b.idealRemaining);

			new Chart(ctx.getContext('2d'), {
				type: 'line',
				data: {
					labels: labels,
					datasets: [
						{ label: 'Ideal', data: ideal, borderColor: 'rgba(148,163,184,0.8)', borderDash: [5,5], fill: false, tension: 0.1 },
						{ label: 'Actual', data: actual, borderColor: 'rgba(239,68,68,0.8)', backgroundColor: 'rgba(239,68,68,0.1)', fill: true, tension: 0.3 }
					]
				},
				options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: { position: 'top', labels: { color: '#fff' } }
						},
						scales: {
							x: { ticks: { color: '#fff' }, grid: { color: 'rgba(255,255,255,0.1)' } },
							y: { ticks: { color: '#fff' }, grid: { color: 'rgba(255,255,255,0.1)' } }
						}
					}
			});
		})();
	</script>
}

// TeamCapacityCard shows team capacity utilization
templ TeamCapacityCard(userStats []models.UserStats, health models.TeamHealth, sprintName string) {
	<div class="glass rounded-2xl p-6 card-hover animate-fade-in">
		<h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
			<span class="text-2xl">👥</span>
			<span>Team Capacity</span>
		</h3>
		<div class="space-y-3 max-h-80 overflow-y-auto">
			for _, us := range userStats {
				<div class="flex items-center gap-3 p-3 bg-white/10 rounded-xl border border-white/20">
					<div class={ "w-10 h-10 rounded-full flex items-center justify-center text-white font-bold " + smGetAvatarColor(us.User.Name) }>
						{ smGetInitials(us.User.Name) }
					</div>
					<div class="flex-1">
						<div class="font-semibold text-white">{ us.User.Name }</div>
						<div class="flex items-center gap-2">
							<div class="flex-1 h-2 bg-white/20 rounded-full overflow-hidden">
								<div class={ "h-full " + getLoadColor(us.AssignedPoints, 10) } style={ fmt.Sprintf("width: %d%%", minInt(us.AssignedPoints*10, 100)) }></div>
							</div>
							<span class="text-sm font-bold text-cyan-200">{ fmt.Sprintf("%d pts", us.AssignedPoints) }</span>
						</div>
					</div>
				</div>
			}
		</div>
		if len(health.CapacityBalance.OverloadedMembers) > 0 {
			<div class="mt-4 p-3 bg-red-500/20 rounded-xl border border-red-400/50">
				<div class="text-sm font-bold text-red-300 mb-1">⚠️ Overloaded Members</div>
				for _, m := range health.CapacityBalance.OverloadedMembers {
					<div class="text-sm text-red-200">{ m.Name } ({ fmt.Sprintf("%.0f%%", m.LoadPercentage) } load)</div>
				}
			</div>
		}
	</div>
}

// RiskIndicatorsCard shows risk indicators
templ RiskIndicatorsCard(risks []models.RiskIndicator) {
	<div class="glass rounded-2xl p-6 card-hover animate-fade-in">
		<h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
			<span class="text-2xl">⚠️</span>
			<span>Risk Indicators</span>
		</h3>
		if len(risks) == 0 {
			<div class="text-center py-8">
				<div class="text-4xl mb-2">✅</div>
				<div class="text-white">No risks identified</div>
			</div>
		} else {
			<div class="space-y-3">
				for _, risk := range risks {
					<div class={ "p-4 rounded-xl border-l-4 " + getRiskBorderColor(risk.Severity) }>
						<div class="flex items-center gap-2 mb-1">
							<span class={ "px-2 py-0.5 rounded text-xs font-bold " + getRiskBadgeColor(risk.Severity) }>
								{ risk.Severity }
							</span>
							<span class="font-bold text-white">{ risk.Title }</span>
						</div>
						<div class="text-sm text-white">{ risk.Description }</div>
					</div>
				}
			</div>
		}
	</div>
}

// SprintHistoryCard shows past sprint performance
templ SprintHistoryCard(history []models.SprintSummary) {
	<div class="glass rounded-2xl p-6 card-hover animate-fade-in">
		<h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
			<span class="text-2xl">📜</span>
			<span>Sprint History</span>
		</h3>
		<div class="space-y-2 max-h-80 overflow-y-auto">
			for _, sprint := range history {
				<div class="flex items-center justify-between p-3 bg-white/10 rounded-xl hover:bg-white/20 transition border border-white/20">
					<div>
						<div class="font-semibold text-white">{ sprint.SprintName }</div>
						<div class="text-xs text-cyan-200">{ fmt.Sprintf("%d/%d pts completed", sprint.Completed, sprint.Committed) }</div>
					</div>
					<div class={ "text-lg font-bold " + getCompletionColor(sprint.CompletionPct) }>
						{ fmt.Sprintf("%.0f%%", sprint.CompletionPct) }
					</div>
				</div>
			}
		</div>
	</div>
}

// BlockersCard shows active blockers
templ BlockersCard(blockers []models.Blocker) {
	<div class="glass rounded-2xl p-6 card-hover animate-fade-in">
		<h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
			<span class="text-2xl">🚫</span>
			<span>Active Blockers</span>
			if len(blockers) > 0 {
				<span class="ml-2 px-2 py-0.5 bg-red-500 text-white text-xs font-bold rounded-full">{ fmt.Sprintf("%d", len(blockers)) }</span>
			}
		</h3>
		if len(blockers) == 0 {
			<div class="text-center py-8">
				<div class="text-4xl mb-2">🎉</div>
				<div class="text-white">No blockers! Team is running smoothly</div>
			</div>
		} else {
			<div class="space-y-3 max-h-80 overflow-y-auto">
				for _, blocker := range blockers {
					<div class="p-4 bg-red-500/20 rounded-xl border border-red-400/50">
						<div class="flex items-center justify-between mb-2">
							<a href={ templ.SafeURL("https://jira-eng-sjc4.cisco.com/jira/browse/" + blocker.Key) } target="_blank" class="font-bold text-red-300 hover:underline">{ blocker.Key }</a>
							<span class="text-xs text-red-200">{ fmt.Sprintf("%d days", blocker.AgeInDays) }</span>
						</div>
						<div class="text-sm text-white">{ blocker.Title }</div>
						<div class="text-xs text-cyan-200 mt-1">Assigned: { blocker.AssignedTo }</div>
					</div>
				}
			</div>
		}
	</div>
}

// Helper functions
func getHealthColor(status string) string {
	switch status {
	case "healthy": return "bg-gradient-to-br from-green-500 to-green-600"
	case "at-risk": return "bg-gradient-to-br from-yellow-500 to-yellow-600"
	case "critical": return "bg-gradient-to-br from-red-500 to-red-600"
	default: return "bg-gradient-to-br from-slate-500 to-slate-600"
	}
}

func getRiskColor(count int) string {
	if count == 0 { return "bg-gradient-to-br from-green-500 to-green-600" }
	if count <= 2 { return "bg-gradient-to-br from-yellow-500 to-yellow-600" }
	return "bg-gradient-to-br from-red-500 to-red-600"
}

func getVelocityTrendClass(trend string) string {
	switch trend {
	case "up": return "bg-green-500/30 text-green-300"
	case "down": return "bg-red-500/30 text-red-300"
	default: return "bg-white/20 text-white"
	}
}

func getVelocityTrendIcon(trend string) string {
	switch trend {
	case "up": return "📈"
	case "down": return "📉"
	default: return "➡️"
	}
}

func getLoadColor(points, capacity int) string {
	pct := float64(points) / float64(capacity) * 100
	if pct > 130 { return "bg-red-500" }
	if pct > 100 { return "bg-yellow-500" }
	return "bg-green-500"
}

func getRiskBorderColor(severity string) string {
	switch severity {
	case "high": return "border-red-400 bg-red-500/20"
	case "medium": return "border-yellow-400 bg-yellow-500/20"
	default: return "border-blue-400 bg-blue-500/20"
	}
}

func getRiskBadgeColor(severity string) string {
	switch severity {
	case "high": return "bg-red-500 text-white"
	case "medium": return "bg-yellow-500 text-white"
	default: return "bg-blue-500 text-white"
	}
}

func getCompletionColor(pct float64) string {
	if pct >= 90 { return "text-green-400" }
	if pct >= 70 { return "text-blue-400" }
	if pct >= 50 { return "text-yellow-400" }
	return "text-red-400"
}

func minInt(a, b int) int {
	if a < b { return a }
	return b
}

func marshalVelocityData(v models.VelocityData) string {
	data, _ := json.Marshal(v)
	return string(data)
}

func marshalBurndownData(b []models.BurndownPoint) string {
	data, _ := json.Marshal(b)
	return string(data)
}

func smGetAvatarColor(name string) string {
	colors := []string{"bg-blue-500", "bg-green-500", "bg-purple-500", "bg-pink-500", "bg-indigo-500", "bg-teal-500"}
	hash := 0
	for _, c := range name { hash += int(c) }
	return colors[hash%len(colors)]
}

func smGetInitials(name string) string {
	if name == "" { return "?" }
	parts := strings.Split(name, " ")
	if len(parts) >= 2 {
		return strings.ToUpper(string(parts[0][0])) + strings.ToUpper(string(parts[len(parts)-1][0]))
	}
	return strings.ToUpper(string(name[0]))
}

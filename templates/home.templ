package templates

import "fmt"

type SprintInfo struct {
	ID        int
	Name      string
	State     string
	StartDate string
	EndDate   string
	Goal      string
}

templ Home(sprints []SprintInfo) {
	@Layout("Scrum Insights") {
		<div class="min-h-screen">
			<!-- Hero Section with Cisco Logo -->
			<header class="gradient-bg text-white py-12 px-8 shadow-lg">
				<div class="max-w-7xl mx-auto text-center">
					<!-- Cisco Logo -->
					<div class="flex items-center justify-center gap-4 mb-6">
						<div class="w-20 h-20 bg-white rounded-2xl flex items-center justify-center shadow-2xl">
							<svg viewBox="0 0 100 100" class="w-16 h-16">
								<!-- Cisco Logo Bars -->
								<rect x="10" y="30" width="8" height="40" fill="#049fd9" rx="2"/>
								<rect x="22" y="20" width="8" height="60" fill="#049fd9" rx="2"/>
								<rect x="34" y="15" width="8" height="70" fill="#049fd9" rx="2"/>
								<rect x="46" y="10" width="8" height="80" fill="#049fd9" rx="2"/>
								<rect x="58" y="15" width="8" height="70" fill="#049fd9" rx="2"/>
								<rect x="70" y="20" width="8" height="60" fill="#049fd9" rx="2"/>
								<rect x="82" y="30" width="8" height="40" fill="#049fd9" rx="2"/>
							</svg>
						</div>
					</div>
					
					<h1 class="text-5xl font-extrabold mb-4 animate-fade-in">
						Scrum Insights
					</h1>
					<p class="text-xl text-white/90 mb-2 animate-fade-in">
						Comprehensive Agile Project Management Dashboard
					</p>
					<p class="text-sm text-white/70 animate-fade-in">
						Powered by Cisco Engineering Excellence
					</p>
				</div>
			</header>

			<!-- Main Content -->
			<main class="max-w-7xl mx-auto px-8 py-12">
				<!-- Welcome Card -->
				<div class="glass rounded-3xl p-8 mb-12 text-center animate-scale-in shadow-2xl">
					<h2 class="text-3xl font-bold text-slate-800 mb-4">
						Welcome to Your Agile Command Center 🚀
					</h2>
					<p class="text-slate-600 text-lg">
						Access real-time insights across sprints, engineers, and defects
					</p>
				</div>

				<!-- Dashboard Cards Grid -->
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
					<!-- Sprint Dashboard Card -->
					<a href="/sprint" class="group">
						<div class="glass rounded-3xl p-8 card-hover text-center transform transition-all duration-300 shadow-xl">
							<div class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-blue-500 to-blue-700 rounded-3xl flex items-center justify-center text-5xl shadow-lg group-hover:scale-110 transition-transform">
								🚀
							</div>
							<h3 class="text-2xl font-bold text-slate-800 mb-3">
								Sprint Dashboard
							</h3>
							<p class="text-slate-600 mb-4">
								Track sprint progress, story points, and team velocity
							</p>
							<div class="flex items-center justify-center gap-2 text-blue-600 font-semibold">
								<span>View Dashboard</span>
								<span class="group-hover:translate-x-2 transition-transform">→</span>
							</div>
						</div>
					</a>

					<!-- Engineer Dashboard Card -->
					<a href="/engineer" class="group">
						<div class="glass rounded-3xl p-8 card-hover text-center transform transition-all duration-300 shadow-xl">
							<div class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-purple-500 to-purple-700 rounded-3xl flex items-center justify-center text-5xl shadow-lg group-hover:scale-110 transition-transform">
								👨‍💻
							</div>
							<h3 class="text-2xl font-bold text-slate-800 mb-3">
								Engineer Dashboard
							</h3>
							<p class="text-slate-600 mb-4">
								Monitor individual performance and workload distribution
							</p>
							<div class="flex items-center justify-center gap-2 text-purple-600 font-semibold">
								<span>View Dashboard</span>
								<span class="group-hover:translate-x-2 transition-transform">→</span>
							</div>
						</div>
					</a>

					<!-- Defect Dashboard Card -->
					<a href="/defects" class="group">
						<div class="glass rounded-3xl p-8 card-hover text-center transform transition-all duration-300 shadow-xl">
							<div class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-red-500 to-red-700 rounded-3xl flex items-center justify-center text-5xl shadow-lg group-hover:scale-110 transition-transform">
								🐛
							</div>
							<h3 class="text-2xl font-bold text-slate-800 mb-3">
								Defect Dashboard
							</h3>
							<p class="text-slate-600 mb-4">
								Manage bugs, track resolution, and analyze severity
							</p>
							<div class="flex items-center justify-center gap-2 text-red-600 font-semibold">
								<span>View Dashboard</span>
								<span class="group-hover:translate-x-2 transition-transform">→</span>
							</div>
						</div>
					</a>
				</div>

				<!-- Quick Stats Section -->
				<div class="glass rounded-3xl p-8 animate-fade-in shadow-xl">
					<h3 class="text-2xl font-bold text-slate-800 mb-6 text-center">
						📊 Quick Overview
					</h3>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
						<div class="text-center p-6 bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl">
							<div class="text-4xl font-extrabold text-blue-600 mb-2">
								{ getSprintCount(sprints) }
							</div>
							<div class="text-slate-600 font-semibold">
								Total Sprints
							</div>
						</div>
						<div class="text-center p-6 bg-gradient-to-br from-purple-50 to-purple-100 rounded-2xl">
							<div class="text-4xl font-extrabold text-purple-600 mb-2">
								5
							</div>
							<div class="text-slate-600 font-semibold">
								Team Members
							</div>
						</div>
						<div class="text-center p-6 bg-gradient-to-br from-green-50 to-green-100 rounded-2xl">
							<div class="text-4xl font-extrabold text-green-600 mb-2">
								Active
							</div>
							<div class="text-slate-600 font-semibold">
								Current Sprint
							</div>
						</div>
					</div>
				</div>
			</main>

			<!-- Footer -->
			<footer class="text-center py-8 text-white/70">
				<p class="text-sm">© 2024 Cisco Systems, Inc. | Scrum Insights Dashboard</p>
			</footer>
		</div>
	}
}

func getSprintCount(sprints []SprintInfo) string {
	return fmt.Sprintf("%d", len(sprints))
}


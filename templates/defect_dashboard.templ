package templates

import "ScrumBoard/internal/models"
import "ScrumBoard/templates/components"

templ DefectDashboard(data models.DefectDashboardData) {
	@Layout("Defect Dashboard") {
		<div class="min-h-screen">
			<!-- Header -->
			<header class="gradient-bg text-white py-6 px-8 shadow-lg">
				<div class="max-w-7xl mx-auto flex items-center justify-between">
					<div class="flex items-center gap-4">
						<div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center text-2xl backdrop-blur">
							🐛
						</div>
						<div>
							<h1 class="text-2xl font-bold">Defect Dashboard</h1>
							<p class="text-white/80 text-sm">Track and analyze defects</p>
						</div>
					</div>
					
					<div class="flex items-center gap-4">
						<!-- Sprint Selector -->
						<div class="glass-dark px-4 py-2 rounded-xl">
							<p class="text-xs text-white/70 mb-1">Sprint</p>
							<select id="sprint-selector" class="bg-white/10 text-white border border-white/20 rounded-lg px-3 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-white/30">
								<option value="0">Loading...</option>
							</select>
						</div>
						
						<a
							id="jira-defect-link"
							href="#"
							target="_blank"
							class="bg-blue-500/80 hover:bg-blue-600/90 px-4 py-2 rounded-xl transition-all flex items-center gap-2"
							title="Open defects in Jira"
						>
							<span>🔗</span>
							<span>Open in Jira</span>
						</a>
						
						<a href="/sprint" class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-xl transition-all flex items-center gap-2">
							<span>📊</span>
							<span>Sprint Dashboard</span>
						</a>
						
						<a href="/engineer" class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-xl transition-all flex items-center gap-2">
							<span>👨‍💻</span>
							<span>Engineers</span>
						</a>
					</div>
				</div>
			</header>

			<!-- Main Content -->
			<main id="defect-content" class="max-w-7xl mx-auto px-8 py-8">
				@DefectDashboardContent(data)
			</main>
		</div>

		<!-- Sprint Selection Script -->
		<script>
			const jiraBaseUrl = 'https://jira-eng-gpk1.cisco.com/jira';
			const urlParams = new URLSearchParams(window.location.search);
			const currentSprintId = parseInt(urlParams.get('sprint') || '0');

			// Update Jira link for defects
			function updateJiraDefectLink(sprintId) {
				const jiraLink = document.getElementById('jira-defect-link');
				if (sprintId && sprintId !== '0') {
					const jql = `type=Bug AND labels=AMFDEVFT AND sprint=${sprintId}`;
					jiraLink.href = `${jiraBaseUrl}/issues/?jql=${encodeURIComponent(jql)}`;
				} else {
					const jql = 'type=Bug AND labels=AMFDEVFT AND sprint in openSprints()';
					jiraLink.href = `${jiraBaseUrl}/issues/?jql=${encodeURIComponent(jql)}`;
				}
			}

			// Set initial Jira link
			updateJiraDefectLink(currentSprintId);

			// Load sprints
			fetch('/defects/api/sprints')
				.then(res => res.json())
				.then(sprints => {
					const selector = document.getElementById('sprint-selector');
					selector.innerHTML = '<option value="0">🟢 Active Sprint</option>';

					sprints.sort((a, b) => b.id - a.id).forEach(sprint => {
						const option = document.createElement('option');
						option.value = sprint.id;
						const stateEmoji = sprint.state === 'active' ? '🟢' : '🔴';
						option.textContent = `${stateEmoji} ${sprint.name}`;
						if (sprint.id === currentSprintId) option.selected = true;
						selector.appendChild(option);
					});
				});

			// Handle sprint change
			document.getElementById('sprint-selector').addEventListener('change', function() {
				const sprintId = this.value;
				updateJiraDefectLink(sprintId);
				window.location.href = `/defects?sprint=${sprintId}`;
			});
		</script>
	}
}

templ DefectDashboardContent(data models.DefectDashboardData) {
	<!-- Sprint Info -->
	<div class="glass rounded-2xl p-6 mb-8 animate-fade-in">
		<div class="flex items-center justify-between">
			<div>
				<h2 class="text-2xl font-bold text-slate-800">{ data.Sprint.Name }</h2>
				<p class="text-sm text-slate-600 mt-1">Defect Analysis</p>
			</div>
			<div class="text-right">
				<p class="text-xs text-slate-500 mb-1">Sprint Period</p>
				<p class="text-sm font-semibold text-slate-700">{ data.Sprint.StartDate } - { data.Sprint.EndDate }</p>
			</div>
		</div>
	</div>

	<!-- Stats Cards -->
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
		@components.DefectStatsCard("Total Defects", data.Stats.TotalDefects, "in sprint", "🐛", "border-l-4 border-red-500")
		@components.DefectStatsCard("Open", data.Stats.OpenDefects, "need attention", "🔴", "border-l-4 border-red-500")
		@components.DefectStatsCard("In Progress", data.Stats.InProgressDefects, "being fixed", "🟡", "border-l-4 border-yellow-500")
		@components.DefectStatsCard("Resolved", data.Stats.ResolvedDefects, "completed", "🟢", "border-l-4 border-green-500")
	</div>

	<!-- Metrics -->
	<div class="mb-8">
		@components.DefectMetricsCard(data.Stats)
	</div>

	<!-- Charts -->
	<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
		@components.DefectStatusPieChart(data.Stats)
		@components.DefectSeverityDoughnutChart(data.Stats)
		@components.DefectAgingPieChart(data.Stats)
	</div>

	<!-- Defect Board -->
	@components.DefectBoard(data.OpenDefects, data.InProgressDefects, data.ResolvedDefects)
}


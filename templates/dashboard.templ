package templates

import "ScrumBoard/internal/models"
import "ScrumBoard/templates/components"
import "fmt"

templ Dashboard(data models.DashboardData) {
	@Layout("Sprint Dashboard") {
		<div class="min-h-screen">
			<!-- Header -->
			<header class="bg-slate-900/80 backdrop-blur-lg text-white py-6 px-8 shadow-xl border-b border-slate-700/50">
				<div class="w-full flex items-center justify-between">
					<div class="flex items-center gap-4">
						<div class="w-12 h-12 bg-slate-800/80 rounded-xl flex items-center justify-center text-2xl shadow-xl">
							🚀
						</div>
						<div>
							<h1 class="text-2xl font-bold text-white">Sprint Dashboard</h1>
							<p class="text-white/70 text-sm">Track sprint progress and team velocity</p>
						</div>
					</div>
					
					<div class="flex items-center gap-4">
						<!-- Sprint Input -->
						<div class="glass-dark px-4 py-2 rounded-xl">
							<p class="text-xs text-white/70 mb-1">Sprint (e.g. NM-2601)</p>
							<div class="flex items-center gap-2">
								<input type="text" id="sprint-input" placeholder="NM-2601"
									class="bg-white/10 text-white border border-white/20 rounded-lg px-3 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-white/30 w-28"
									maxlength="10" />
								<button id="sprint-go-btn" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded-lg text-sm font-medium transition-all">
									Go
								</button>
							</div>
						</div>
						

						
						<a href="/" class="bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-600 hover:to-pink-600 px-4 py-2 rounded-xl transition-all flex items-center gap-2 shadow-lg">
							<span>🏠</span>
							<span>Home</span>
						</a>

						<a href="/defects" class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-xl transition-all flex items-center gap-2">
							<span>🐛</span>
							<span>Defects</span>
						</a>

						<a href="/engineer" class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-xl transition-all flex items-center gap-2">
							<span>👨‍💻</span>
							<span>Engineers</span>
						</a>
					</div>
				</div>
			</header>

			<!-- Main Content -->
			<main id="dashboard-content" class="w-full px-6 py-8">
				@DashboardContent(data)
			</main>
		</div>

		<!-- Sprint Selection Script -->
		<script>
			const jiraBaseUrl = 'https://jira-eng-gpk1.cisco.com/jira';
			const urlParams = new URLSearchParams(window.location.search);
			const currentSprintName = urlParams.get('sprintName') || '';

			// Sprint name to ID mapping
			let sprintMap = {};

			// Update Jira link
			function updateJiraLink(sprintName) {
				const jiraLink = document.getElementById('jira-sprint-link');
				if (!jiraLink) return;
				if (sprintName) {
					const jql = `sprint="${sprintName}"`;
					jiraLink.href = `${jiraBaseUrl}/issues/?jql=${encodeURIComponent(jql)}`;
				} else {
					jiraLink.href = `${jiraBaseUrl}/secure/RapidBoard.jspa?rapidView=6991`;
				}
			}

			// Set initial Jira link
			updateJiraLink(currentSprintName);

			// Load sprints to build name->ID map
			fetch('/api/sprints')
				.then(res => res.json())
				.then(sprints => {
					sprints.forEach(sprint => {
						sprintMap[sprint.name.toUpperCase()] = sprint.id;
					});
					console.log('Sprint map loaded:', Object.keys(sprintMap).length, 'sprints');
				})
				.catch(err => console.error('Error loading sprints:', err));

			// Set current sprint name in input
			if (currentSprintName) {
				document.getElementById('sprint-input').value = currentSprintName;
			}

			// Go to sprint function
			function goToSprint(sprintName) {
				if (!sprintName) {
					window.location.href = '/sprint?sprint=0';
					return;
				}

				const sprintId = sprintMap[sprintName.toUpperCase()];
				if (sprintId) {
					window.location.href = `/sprint?sprint=${sprintId}&sprintName=${encodeURIComponent(sprintName)}`;
				} else {
					fetch(`/api/sprint/search?name=${encodeURIComponent(sprintName)}`)
						.then(res => res.json())
						.then(data => {
							if (data.id) {
								window.location.href = `/sprint?sprint=${data.id}&sprintName=${encodeURIComponent(sprintName)}`;
							} else {
								alert('Sprint not found: ' + sprintName);
							}
						})
						.catch(() => alert('Sprint not found: ' + sprintName));
				}
			}

			// Handle Go button click
			document.getElementById('sprint-go-btn').addEventListener('click', function() {
				const sprintName = document.getElementById('sprint-input').value.trim();
				goToSprint(sprintName);
			});

			// Handle Enter key in sprint input
			document.getElementById('sprint-input').addEventListener('keypress', function(e) {
				if (e.key === 'Enter') {
					goToSprint(this.value.trim());
				}
			});

			// Load info requests function
			function loadSprintInfoRequests() {
				fetch('/engineer/api/pings')
					.then(function(res) { return res.json(); })
					.then(function(data) {
						var reqList = document.getElementById('sprint-info-request-list');
						if (!reqList) return;

						if (!data.pings || data.pings.length === 0) {
							reqList.innerHTML = '<p class="text-cyan-200 text-center py-4">No info requests yet. Use 📋 button on stories to request info.</p>';
							return;
						}

						reqList.innerHTML = data.pings.map(function(ping) {
							var borderClass = ping.status === 'responded' ? 'border-green-400' : 'border-yellow-400';
							var statusClass = ping.status === 'responded' ? 'bg-green-500/30 text-green-300' : 'bg-yellow-500/30 text-yellow-300';
							var statusText = ping.status === 'responded' ? '✅ Responded' : '⏳ Awaiting Reply';
							var responseHtml = '';
							if (ping.response) {
								responseHtml = '<div class="mt-3 bg-green-500/20 rounded-lg p-3 border border-green-400/50">' +
									'<p class="text-xs text-green-300 mb-1">📩 Response (' + ping.responded_at + '):</p>' +
									'<p class="text-sm text-green-200 font-medium">' + ping.response + '</p></div>';
							}
							var itemHtml = ping.item_key ? '<p class="text-sm font-bold text-blue-300 mb-1">🎯 ' + ping.item_key + ': ' + (ping.item_title || '') + '</p>' : '';
							return '<div class="glass rounded-xl p-4 border-l-4 ' + borderClass + '">' +
								'<div class="flex items-center justify-between mb-2">' +
								'<div class="flex items-center gap-2">' +
								'<span class="font-bold text-white">' + ping.engineer_name + '</span>' +
								'<span class="text-xs text-cyan-200">(' + ping.engineer_email + ')</span></div>' +
								'<span class="px-2 py-1 rounded-full text-xs font-semibold ' + statusClass + '">' + statusText + '</span></div>' +
								itemHtml +
								'<div class="flex items-center gap-4 text-xs text-cyan-200 mb-2">' +
								'<span>📤 Requested: ' + ping.sent_at + '</span></div>' +
								responseHtml + '</div>';
						}).join('');
					})
					.catch(function(err) {
						console.error('Error loading info requests:', err);
						document.getElementById('sprint-info-request-list').innerHTML = '<p class="text-red-400 text-center py-4">Error loading info requests</p>';
					});
			}

			// Load info requests on page load
			loadSprintInfoRequests();

			// Request Info button handler
			document.querySelectorAll('.request-info-btn').forEach(btn => {
				btn.addEventListener('click', async function(e) {
					e.stopPropagation();
					const email = this.dataset.email;
					const name = this.dataset.name;
					const itemKey = this.dataset.itemKey;
					const itemTitle = this.dataset.itemTitle;
					const itemType = this.dataset.itemType;
					const sprintName = document.querySelector('#sprint-selector option:checked')?.textContent || 'Current Sprint';

					if (!email) {
						alert('No email available for this assignee');
						return;
					}

					this.disabled = true;
					this.innerHTML = '⏳';

					try {
						const response = await fetch('/api/request-info', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								email: email,
								name: name,
								sprintName: sprintName.replace(/^[🟢🔴]\s*/, ''),
								itemKey: itemKey,
								itemTitle: itemTitle,
								itemType: itemType
							})
						});

						const result = await response.json();

						if (result.success) {
							this.innerHTML = '✅';
							setTimeout(() => {
								this.innerHTML = '📋';
								this.disabled = false;
							}, 2000);
						} else {
							throw new Error(result.error || 'Failed to send');
						}
					} catch (error) {
						this.innerHTML = '❌';
						console.error('Request info error:', error);
						setTimeout(() => {
							this.innerHTML = '📋';
							this.disabled = false;
						}, 2000);
					}
				});
			});
		</script>
	}
}

templ DashboardContent(data models.DashboardData) {
	<!-- Sprint Info -->
	<div class="glass rounded-2xl p-6 mb-8 animate-fade-in">
		<div class="flex items-center justify-between">
			<div>
				<h2 class="text-2xl font-bold text-white">{ data.Sprint.Name }</h2>
				<p class="text-sm text-white mt-1">{ data.Sprint.Goal }</p>
			</div>
			<div class="text-right">
				<p class="text-xs text-cyan-200 mb-1">Sprint Period</p>
				<p class="text-sm font-semibold text-white">{ data.Sprint.StartDate } - { data.Sprint.EndDate }</p>
			</div>
		</div>
	</div>

	<!-- Stats Cards -->
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
		@components.StatsCard("Total Stories", data.Stats.TotalStories, "in sprint", "📖", "border-l-4 border-primary-500")
		@components.StatsCard("Completed", data.Stats.CompletedStories, "stories done", "✅", "border-l-4 border-emerald-500")
		@components.StatsCard("Total Points", data.Stats.TotalPoints, fmt.Sprintf("%d completed", data.Stats.CompletedPoints), "⚡", "border-l-4 border-secondary-500")
		@components.StatsCard("In Progress", data.Stats.InProgressStories, fmt.Sprintf("%d points", data.Stats.InProgressPoints), "🔄", "border-l-4 border-amber-500")
	</div>

	<!-- Progress Bar -->
	<div class="mb-8">
		@components.ProgressBar(data.Stats.CompletedPoints, data.Stats.TotalPoints)
	</div>

	<!-- Charts -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
		@components.SprintProgressPieChart(data.Stats)
		@components.TeamWorkDistributionChart(data.UserStats)
	</div>

	<!-- Info Requests & Responses Section -->
	<div class="glass rounded-2xl p-6 mb-8 animate-fade-in">
		<h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
			<span class="text-2xl">📩</span>
			<span>Info Requests & Responses</span>
			<button onclick="loadSprintInfoRequests()" class="ml-auto px-3 py-1 bg-blue-500 hover:bg-blue-600 text-white text-xs font-semibold rounded-lg transition-all">
				🔄 Refresh
			</button>
		</h3>
		<div id="sprint-info-request-list" class="space-y-3 max-h-96 overflow-y-auto">
			<p class="text-cyan-200 text-center py-4">Loading info requests...</p>
		</div>
	</div>

	<!-- Story Board -->
	@components.SprintBoard(data.TodoStories, data.InProgress, data.DoneStories)
}


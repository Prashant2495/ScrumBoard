package templates

import "ScrumBoard/internal/models"
import "ScrumBoard/templates/components"
import "fmt"

templ Dashboard(data models.DashboardData) {
	@Layout("Sprint Dashboard") {
		<div class="min-h-screen">
			<!-- Header -->
			<header class="gradient-bg text-white py-6 px-8 shadow-lg">
				<div class="w-full flex items-center justify-between">
					<div class="flex items-center gap-4">
						<div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center text-2xl backdrop-blur">
							🚀
						</div>
						<div>
							<h1 class="text-2xl font-bold">Sprint Dashboard</h1>
							<p class="text-white/80 text-sm">Track sprint progress and team velocity</p>
						</div>
					</div>
					
					<div class="flex items-center gap-4">
						<!-- Sprint Selector -->
						<div class="glass-dark px-4 py-2 rounded-xl">
							<p class="text-xs text-white/70 mb-1">Sprint</p>
							<select id="sprint-selector" class="bg-white/10 text-white border border-white/20 rounded-lg px-3 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-white/30">
								<option value="0">Loading...</option>
							</select>
						</div>
						
						<a
							id="jira-sprint-link"
							href="#"
							target="_blank"
							class="bg-blue-500/80 hover:bg-blue-600/90 px-4 py-2 rounded-xl transition-all flex items-center gap-2"
							title="Open in Jira"
						>
							<span>🔗</span>
							<span>Open in Jira</span>
						</a>
						
						<a href="/defects" class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-xl transition-all flex items-center gap-2">
							<span>🐛</span>
							<span>Defects</span>
						</a>
						
						<a href="/engineer" class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-xl transition-all flex items-center gap-2">
							<span>👨‍💻</span>
							<span>Engineers</span>
						</a>
					</div>
				</div>
			</header>

			<!-- Main Content -->
			<main id="dashboard-content" class="w-full px-6 py-8">
				@DashboardContent(data)
			</main>
		</div>

		<!-- Sprint Selection Script -->
		<script>
			const jiraBaseUrl = 'https://jira-eng-gpk1.cisco.com/jira';
			const urlParams = new URLSearchParams(window.location.search);
			const currentSprintId = parseInt(urlParams.get('sprint') || '0');

			// Update Jira link
			function updateJiraLink(sprintId) {
				const jiraLink = document.getElementById('jira-sprint-link');
				if (sprintId && sprintId !== '0') {
					jiraLink.href = `${jiraBaseUrl}/secure/RapidBoard.jspa?rapidView=6991&sprint=${sprintId}`;
				} else {
					jiraLink.href = `${jiraBaseUrl}/secure/RapidBoard.jspa?rapidView=6991`;
				}
			}

			// Set initial Jira link
			updateJiraLink(currentSprintId);

			// Load sprints
			fetch('/api/sprints')
				.then(res => res.json())
				.then(sprints => {
					const selector = document.getElementById('sprint-selector');
					selector.innerHTML = '<option value="0">🟢 Active Sprint</option>';

					sprints.sort((a, b) => b.id - a.id).forEach(sprint => {
						const option = document.createElement('option');
						option.value = sprint.id;
						const stateEmoji = sprint.state === 'active' ? '🟢' : '🔴';
						option.textContent = `${stateEmoji} ${sprint.name}`;
						if (sprint.id === currentSprintId) option.selected = true;
						selector.appendChild(option);
					});
				});

			// Handle sprint change
			document.getElementById('sprint-selector').addEventListener('change', function() {
				const sprintId = this.value;
				updateJiraLink(sprintId);
				window.location.href = `/sprint?sprint=${sprintId}`;
			});

			// Request Info button handler
			document.querySelectorAll('.request-info-btn').forEach(btn => {
				btn.addEventListener('click', async function(e) {
					e.stopPropagation();
					const email = this.dataset.email;
					const name = this.dataset.name;
					const itemKey = this.dataset.itemKey;
					const itemTitle = this.dataset.itemTitle;
					const itemType = this.dataset.itemType;
					const sprintName = document.querySelector('#sprint-selector option:checked')?.textContent || 'Current Sprint';

					if (!email) {
						alert('No email available for this assignee');
						return;
					}

					this.disabled = true;
					this.innerHTML = '⏳';

					try {
						const response = await fetch('/api/request-info', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								email: email,
								name: name,
								sprintName: sprintName.replace(/^[🟢🔴]\s*/, ''),
								itemKey: itemKey,
								itemTitle: itemTitle,
								itemType: itemType
							})
						});

						const result = await response.json();

						if (result.success) {
							this.innerHTML = '✅';
							setTimeout(() => {
								this.innerHTML = '📋';
								this.disabled = false;
							}, 2000);
						} else {
							throw new Error(result.error || 'Failed to send');
						}
					} catch (error) {
						this.innerHTML = '❌';
						console.error('Request info error:', error);
						setTimeout(() => {
							this.innerHTML = '📋';
							this.disabled = false;
						}, 2000);
					}
				});
			});
		</script>
	}
}

templ DashboardContent(data models.DashboardData) {
	<!-- Sprint Info -->
	<div class="glass rounded-2xl p-6 mb-8 animate-fade-in">
		<div class="flex items-center justify-between">
			<div>
				<h2 class="text-2xl font-bold text-slate-800">{ data.Sprint.Name }</h2>
				<p class="text-sm text-slate-600 mt-1">{ data.Sprint.Goal }</p>
			</div>
			<div class="text-right">
				<p class="text-xs text-slate-500 mb-1">Sprint Period</p>
				<p class="text-sm font-semibold text-slate-700">{ data.Sprint.StartDate } - { data.Sprint.EndDate }</p>
			</div>
		</div>
	</div>

	<!-- Stats Cards -->
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
		@components.StatsCard("Total Stories", data.Stats.TotalStories, "in sprint", "📖", "border-l-4 border-primary-500")
		@components.StatsCard("Completed", data.Stats.CompletedStories, "stories done", "✅", "border-l-4 border-emerald-500")
		@components.StatsCard("Total Points", data.Stats.TotalPoints, fmt.Sprintf("%d completed", data.Stats.CompletedPoints), "⚡", "border-l-4 border-secondary-500")
		@components.StatsCard("In Progress", data.Stats.InProgressStories, fmt.Sprintf("%d points", data.Stats.InProgressPoints), "🔄", "border-l-4 border-amber-500")
	</div>

	<!-- Progress Bar -->
	<div class="mb-8">
		@components.ProgressBar(data.Stats.CompletedPoints, data.Stats.TotalPoints)
	</div>

	<!-- Charts -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
		@components.SprintProgressPieChart(data.Stats)
		@components.TeamWorkDistributionChart(data.UserStats)
	</div>

	<!-- Story Board -->
	@components.SprintBoard(data.TodoStories, data.InProgress, data.DoneStories)
}


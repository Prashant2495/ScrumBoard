package templates

import "ScrumBoard/internal/models"
import "ScrumBoard/templates/components"
import "fmt"

templ EngineerDashboard(data models.EngineerDashboardData, engineers []models.Engineer, sprints []models.Sprint) {
	@Layout("Engineer Dashboard") {
		<div class="min-h-screen">
			<!-- Header -->
			<header class="gradient-bg text-white py-6 px-8 shadow-lg">
				<div class="max-w-7xl mx-auto flex items-center justify-between">
					<div class="flex items-center gap-4">
						<div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center text-2xl backdrop-blur">
							👨‍💻
						</div>
						<div>
							<h1 class="text-2xl font-bold">Engineer Dashboard</h1>
							<p class="text-white/80 text-sm">Individual performance tracking</p>
						</div>
					</div>
					
					<div class="flex items-center gap-4">
						<!-- Engineer Selector -->
						<div class="glass-dark px-4 py-2 rounded-xl">
							<p class="text-xs text-white/70 mb-1">Engineer</p>
							<select id="engineer-selector" class="bg-white/10 text-white border border-white/20 rounded-lg px-3 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-white/30">
								<option value="">Select Engineer</option>
								<option value="prdewang@cisco.com">Prashant Dewangan</option>
								<option value="amitksi3@cisco.com">Amit Kumar Singh</option>
								<option value="surasin2@cisco.com">Suraj Singh</option>
								<option value="akbhat2@cisco.com">Akshay Bhat</option>
								<option value="shabhart@cisco.com">Shashi Kiran Bharti</option>
							</select>
						</div>
						
						<!-- Sprint Selector -->
						<div class="glass-dark px-4 py-2 rounded-xl">
							<p class="text-xs text-white/70 mb-1">Sprint</p>
							<select id="sprint-selector" class="bg-white/10 text-white border border-white/20 rounded-lg px-3 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-white/30">
								<option value="0">Loading...</option>
							</select>
						</div>
						
						<a
							id="jira-engineer-link"
							href="#"
							target="_blank"
							class="bg-blue-500/80 hover:bg-blue-600/90 px-4 py-2 rounded-xl transition-all flex items-center gap-2"
							title="Open engineer's work in Jira"
						>
							<span>🔗</span>
							<span>Open in Jira</span>
						</a>
						
						<a href="/" class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-xl transition-all flex items-center gap-2">
							<span>📊</span>
							<span>Sprint Dashboard</span>
						</a>
						
						<a href="/defects" class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-xl transition-all flex items-center gap-2">
							<span>🐛</span>
							<span>Defects</span>
						</a>
					</div>
				</div>
			</header>

			<!-- Main Content -->
			<main id="engineer-content" class="max-w-7xl mx-auto px-8 py-8">
				@EngineerDashboardContent(data)
			</main>
		</div>

		<!-- Selection Script -->
		<script>
			const jiraBaseUrl = 'https://jira-eng-gpk1.cisco.com/jira';
			const urlParams = new URLSearchParams(window.location.search);
			const currentEngineer = urlParams.get('email');
			const currentSprintId = parseInt(urlParams.get('sprint') || '0');

			// Update Jira link for engineer
			function updateJiraEngineerLink(engineer, sprintId) {
				const jiraLink = document.getElementById('jira-engineer-link');
				if (engineer) {
					// Extract name from email (e.g., prdewang@cisco.com -> prdewang)
					const username = engineer.split('@')[0];
					
					if (sprintId && sprintId !== '0') {
						// JQL query for engineer's work in specific sprint
						const jql = `assignee=${username} AND sprint=${sprintId}`;
						jiraLink.href = `${jiraBaseUrl}/issues/?jql=${encodeURIComponent(jql)}`;
					} else {
						// JQL query for engineer's work in active sprint
						const jql = `assignee=${username} AND sprint in openSprints()`;
						jiraLink.href = `${jiraBaseUrl}/issues/?jql=${encodeURIComponent(jql)}`;
					}
				} else {
					// Default to board view
					jiraLink.href = `${jiraBaseUrl}/secure/RapidBoard.jspa?rapidView=6991`;
				}
			}

			// Set initial Jira link
			updateJiraEngineerLink(currentEngineer, currentSprintId);

			// Load sprints
			fetch('/defects/api/sprints')
				.then(res => res.json())
				.then(sprints => {
					const selector = document.getElementById('sprint-selector');

					selector.innerHTML = '<option value="0">🟢 Active Sprint</option>';

					sprints.sort((a, b) => b.id - a.id).forEach(sprint => {
						const option = document.createElement('option');
						option.value = sprint.id;
						const stateEmoji = sprint.state === 'active' ? '🟢' : '🔴';
						option.textContent = `${stateEmoji} ${sprint.name}`;
						if (sprint.id === currentSprintId) option.selected = true;
						selector.appendChild(option);
					});
				});

			// Handle engineer change
			document.getElementById('engineer-selector').addEventListener('change', function() {
				const engineer = this.value;
				const sprint = document.getElementById('sprint-selector').value;
				updateJiraEngineerLink(engineer, sprint);
				if (engineer) {
					window.location.href = `/engineer?email=${engineer}&sprint=${sprint}`;
				}
			});

			// Handle sprint change
			document.getElementById('sprint-selector').addEventListener('change', function() {
				const engineer = document.getElementById('engineer-selector').value;
				const sprint = this.value;
				updateJiraEngineerLink(engineer, sprint);
				if (engineer) {
					window.location.href = `/engineer?email=${engineer}&sprint=${sprint}`;
				}
			});

			// Set current engineer
			if (currentEngineer) {
				document.getElementById('engineer-selector').value = currentEngineer;
			}
		</script>
	}
}

templ EngineerDashboardContent(data models.EngineerDashboardData) {
	<!-- Engineer Profile Header -->
	<div class="glass rounded-2xl p-6 mb-8 flex items-center justify-between animate-fade-in">
		<div class="flex items-center gap-6">
			<div class={ "w-16 h-16 rounded-full flex items-center justify-center text-white text-2xl font-bold " + data.Engineer.AvatarColor }>
				{ getInitials(data.Engineer.Name) }
			</div>
			<div>
				<h2 class="text-2xl font-bold text-slate-800">{ data.Engineer.Name }</h2>
				<p class="text-sm text-slate-600">{ data.Engineer.Email }</p>
				<p class="text-sm text-slate-500 mt-1">Sprint: { data.Sprint.Name }</p>
			</div>
		</div>
		<div class="text-right">
			<p class="text-xs text-slate-500 mb-1">Sprint Period</p>
			<p class="text-sm font-semibold text-slate-700">
				if data.Sprint.StartDate != "" {
					{ data.Sprint.StartDate } - { data.Sprint.EndDate }
				} else {
					-
				}
			</p>
		</div>
	</div>

	<!-- Stats Cards -->
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
		@components.StatsCard("Total Stories", data.Stats.TotalStories, "assigned", "📖", "from-blue-500 to-blue-600")
		@components.StatsCard("Completed", data.Stats.CompletedStories, "stories done", "✅", "from-green-500 to-green-600")
		@components.StatsCard("Story Points", data.Stats.StoryPoints, fmt.Sprintf("%d completed", data.Stats.CompletedPoints), "⚡", "from-purple-500 to-purple-600")
		@components.StatsCard("Defects", data.Stats.TotalDefects, fmt.Sprintf("%d resolved", data.Stats.ResolvedDefects), "🐛", "from-red-500 to-red-600")
	</div>

	<!-- Charts Row 1 -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
		@components.EngineerWorkDistribution(data.Stories, data.Defects)
		@components.StoryPointsProgress(data.Stats.CompletedPoints, data.Stats.StoryPoints)
	</div>

	<!-- Charts Row 2 -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
		@components.EngineerStoryStatusPieChart(data.Stories)
		@components.EngineerDefectStatusPieChart(data.Defects)
	</div>

	<!-- Stories Section -->
	<div class="mb-8">
		<h3 class="text-xl font-bold text-slate-800 mb-4 flex items-center gap-2">
			<span>📖</span>
			<span>Stories ({ fmt.Sprintf("%d", len(data.Stories)) })</span>
		</h3>

		if len(data.Stories) > 0 {
			<div class="grid grid-cols-1 gap-4">
				for _, story := range data.Stories {
					@components.StoryCard(story)
				}
			</div>
		} else {
			<p class="text-slate-500 text-center py-8">No stories assigned in this sprint</p>
		}
	</div>

	<!-- Defects Section -->
	<div class="mb-8">
		<h3 class="text-xl font-bold text-slate-800 mb-4 flex items-center gap-2">
			<span>🐛</span>
			<span>Defects ({ fmt.Sprintf("%d", len(data.Defects)) })</span>
		</h3>

		if len(data.Defects) > 0 {
			<div class="grid grid-cols-1 gap-4">
				for _, defect := range data.Defects {
					@components.DefectCard(defect)
				}
			</div>
		} else {
			<p class="text-slate-500 text-center py-8">No defects assigned in this sprint</p>
		}
	</div>
}

func getInitials(name string) string {
	if name == "" || name == "Select an Engineer" {
		return "?"
	}

	// Split name and get first letter of each word
	words := []rune(name)
	if len(words) > 0 {
		return string(words[0])
	}
	return "?"
}


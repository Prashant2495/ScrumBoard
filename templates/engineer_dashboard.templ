package templates

import "ScrumBoard/internal/models"
import "ScrumBoard/templates/components"
import "fmt"

templ EngineerDashboard(data models.EngineerDashboardData, engineers []models.Engineer, sprints []models.Sprint) {
	@Layout("Engineer Dashboard") {
		<div class="min-h-screen">
			<!-- Header -->
			<header class="bg-slate-900/80 backdrop-blur-lg text-white py-6 px-8 shadow-xl border-b border-slate-700/50">
				<div class="w-full flex items-center justify-between">
					<div class="flex items-center gap-4">
						<div class="w-12 h-12 bg-slate-800/80 rounded-xl flex items-center justify-center text-2xl shadow-xl">
							👨‍💻
						</div>
						<div>
							<h1 class="text-2xl font-bold text-white">Engineer Dashboard</h1>
							<p class="text-white/70 text-sm">Individual performance tracking</p>
						</div>
					</div>
					
					<div class="flex items-center gap-4">
						<!-- Engineer Selector -->
						<div class="glass-dark px-4 py-2 rounded-xl">
							<p class="text-xs text-white/70 mb-1">Engineer</p>
							<select id="engineer-selector" class="bg-white/10 text-white border border-white/20 rounded-lg px-3 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-white/30">
								<option value="">Select Engineer</option>
								<option value="prdewang@cisco.com">Prashant Dewangan</option>
								<option value="amitksi3@cisco.com">Amit Kumar Singh</option>
								<option value="surasin2@cisco.com">Suraj Singh</option>
								<option value="akbhat2@cisco.com">Akshay Bhat</option>
								<option value="shabhart@cisco.com">Shashi Kiran Bharti</option>
							</select>
						</div>
						
						<!-- Sprint Input -->
						<div class="glass-dark px-4 py-2 rounded-xl">
							<p class="text-xs text-white/70 mb-1">Sprint (e.g. NM-2601)</p>
							<div class="flex items-center gap-2">
								<input type="text" id="sprint-input" placeholder="NM-2601"
									class="bg-white/10 text-white border border-white/20 rounded-lg px-3 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-white/30 w-28"
									maxlength="10" />
								<button id="sprint-go-btn" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded-lg text-sm font-medium transition-all">
									Go
								</button>
							</div>
						</div>
						
						<a href="/" class="bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-600 hover:to-pink-600 px-4 py-2 rounded-xl transition-all flex items-center gap-2 shadow-lg">
							<span>🏠</span>
							<span>Home</span>
						</a>

						<a href="/sprint" class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-xl transition-all flex items-center gap-2">
							<span>📊</span>
							<span>Sprint</span>
						</a>

						<a href="/defects" class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-xl transition-all flex items-center gap-2">
							<span>🐛</span>
							<span>Defects</span>
						</a>
					</div>
				</div>
			</header>

			<!-- Main Content -->
			<main id="engineer-content" class="w-full px-6 py-8">
				@EngineerDashboardContent(data)
			</main>
		</div>

		<!-- Selection Script -->
		<script>
			const jiraBaseUrl = 'https://jira-eng-gpk1.cisco.com/jira';
			const urlParams = new URLSearchParams(window.location.search);
			const currentEngineer = urlParams.get('email');
			const currentSprintName = urlParams.get('sprintName') || '';

			// Sprint name to ID mapping (will be loaded from API)
			let sprintMap = {};

			// Update Jira link for engineer
			function updateJiraEngineerLink(engineer, sprintName) {
				const jiraLink = document.getElementById('jira-engineer-link');
				if (!jiraLink) return;
				if (engineer) {
					const username = engineer.split('@')[0];
					if (sprintName) {
						const jql = `assignee=${username} AND sprint="${sprintName}"`;
						jiraLink.href = `${jiraBaseUrl}/issues/?jql=${encodeURIComponent(jql)}`;
					} else {
						const jql = `assignee=${username} AND sprint in openSprints()`;
						jiraLink.href = `${jiraBaseUrl}/issues/?jql=${encodeURIComponent(jql)}`;
					}
				} else {
					jiraLink.href = `${jiraBaseUrl}/secure/RapidBoard.jspa?rapidView=6991`;
				}
			}

			// Set initial Jira link
			updateJiraEngineerLink(currentEngineer, currentSprintName);

			// Load sprints to build name->ID map
			fetch('/api/sprints')
				.then(res => res.json())
				.then(sprints => {
					sprints.forEach(sprint => {
						sprintMap[sprint.name.toUpperCase()] = sprint.id;
					});
					console.log('Sprint map loaded:', Object.keys(sprintMap).length, 'sprints');
				})
				.catch(err => console.error('Error loading sprints:', err));

			// Set current sprint name in input
			if (currentSprintName) {
				document.getElementById('sprint-input').value = currentSprintName;
			}

			// Handle engineer change
			document.getElementById('engineer-selector').addEventListener('change', function() {
				const engineer = this.value;
				const sprintName = document.getElementById('sprint-input').value.trim();
				updateJiraEngineerLink(engineer, sprintName);
				if (engineer) {
					goToSprint(engineer, sprintName);
				}
			});

			// Go to sprint function
			function goToSprint(engineer, sprintName) {
				if (!engineer) {
					alert('Please select an engineer first');
					return;
				}

				if (!sprintName) {
					window.location.href = `/engineer?email=${engineer}&sprint=0`;
					return;
				}

				// Look up sprint ID from name
				const sprintId = sprintMap[sprintName.toUpperCase()];
				if (sprintId) {
					window.location.href = `/engineer?email=${engineer}&sprint=${sprintId}&sprintName=${encodeURIComponent(sprintName)}`;
				} else {
					// Try direct API search by name
					fetch(`/api/sprint/search?name=${encodeURIComponent(sprintName)}`)
						.then(res => res.json())
						.then(data => {
							if (data.id) {
								window.location.href = `/engineer?email=${engineer}&sprint=${data.id}&sprintName=${encodeURIComponent(sprintName)}`;
							} else {
								alert('Sprint not found: ' + sprintName);
							}
						})
						.catch(() => {
							alert('Sprint not found: ' + sprintName);
						});
				}
			}

			// Handle Go button click
			document.getElementById('sprint-go-btn').addEventListener('click', function() {
				const engineer = document.getElementById('engineer-selector').value;
				const sprintName = document.getElementById('sprint-input').value.trim();
				goToSprint(engineer, sprintName);
			});

			// Handle Enter key in sprint input
			document.getElementById('sprint-input').addEventListener('keypress', function(e) {
				if (e.key === 'Enter') {
					const engineer = document.getElementById('engineer-selector').value;
					const sprintName = this.value.trim();
					goToSprint(engineer, sprintName);
				}
			});

			// Set current engineer
			if (currentEngineer) {
				document.getElementById('engineer-selector').value = currentEngineer;
			}

			// Load info request history
			function loadInfoRequests(email) {
				if (!email) return;
				fetch('/engineer/api/pings?email=' + encodeURIComponent(email))
					.then(function(res) { return res.json(); })
					.then(function(data) {
						const pingList = document.getElementById('info-request-list');
						if (!pingList) return;

						if (!data.pings || data.pings.length === 0) {
							pingList.innerHTML = '<p class="text-cyan-200 text-center py-4">No info requests yet</p>';
							return;
						}

						pingList.innerHTML = data.pings.map(function(ping) {
							var borderClass = ping.status === 'responded' ? 'border-green-400' : 'border-yellow-400';
							var statusClass = ping.status === 'responded' ? 'bg-green-500/30 text-green-300' : 'bg-yellow-500/30 text-yellow-300';
							var statusText = ping.status === 'responded' ? '✅ Responded' : '⏳ Awaiting Reply';
							var responseHtml = '';
							if (ping.response) {
								responseHtml = '<div class="mt-3 bg-green-500/20 rounded-lg p-3 border border-green-400/50">' +
									'<p class="text-xs text-green-300 mb-1">📩 Response (' + ping.responded_at + '):</p>' +
									'<p class="text-sm text-green-200">' + ping.response + '</p></div>';
							} else {
								responseHtml = '<div class="mt-2 text-xs text-yellow-300 italic">💬 Reply via Webex to respond</div>';
							}
							var itemHtml = ping.item_key ? '<p class="text-sm font-medium text-blue-300 mb-1">🎯 ' + ping.item_key + ': ' + (ping.item_title || '') + '</p>' : '';
							return '<div class="bg-white/10 rounded-xl p-4 border border-white/20 ' + borderClass + '">' +
								'<div class="flex items-center justify-between mb-2">' +
								'<span class="text-xs text-cyan-200">📤 Requested: ' + ping.sent_at + '</span>' +
								'<span class="px-2 py-1 rounded-full text-xs ' + statusClass + '">' + statusText + '</span></div>' +
								itemHtml +
								'<p class="text-sm text-white mb-2">Sprint: <strong>' + ping.sprint_name + '</strong></p>' +
								responseHtml + '</div>';
						}).join('');
					})
					.catch(function(err) {
						console.error('Error loading info requests:', err);
					});
			}

			// Load info request history on page load
			if (currentEngineer) {
				loadInfoRequests(currentEngineer);
			}

			// Request Info button handler
			document.querySelectorAll('.request-info-btn').forEach(btn => {
				btn.addEventListener('click', async function(e) {
					e.stopPropagation();
					const email = this.dataset.email;
					const name = this.dataset.name;
					const itemKey = this.dataset.itemKey;
					const itemTitle = this.dataset.itemTitle;
					const itemType = this.dataset.itemType;
					const sprintName = document.querySelector('#sprint-selector option:checked')?.textContent || 'Current Sprint';

					if (!email) {
						alert('No email available for this assignee');
						return;
					}

					this.disabled = true;
					this.innerHTML = '⏳';

					try {
						const response = await fetch('/api/request-info', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								email: email,
								name: name,
								sprintName: sprintName.replace(/^[🟢🔴]\s*/, ''),
								itemKey: itemKey,
								itemTitle: itemTitle,
								itemType: itemType
							})
						});

						const result = await response.json();

						if (result.success) {
							this.innerHTML = '✅';
							// Reload info requests
							if (currentEngineer) {
								loadInfoRequests(currentEngineer);
							}
							setTimeout(() => {
								this.innerHTML = '📋';
								this.disabled = false;
							}, 2000);
						} else {
							throw new Error(result.error || 'Failed to send');
						}
					} catch (error) {
						this.innerHTML = '❌';
						console.error('Request info error:', error);
						setTimeout(() => {
							this.innerHTML = '📋';
							this.disabled = false;
						}, 2000);
					}
				});
			});
		</script>
	}
}

templ EngineerDashboardContent(data models.EngineerDashboardData) {
	<!-- Engineer Profile Header -->
	<div class="glass rounded-2xl p-6 mb-8 flex items-center justify-between animate-fade-in">
		<div class="flex items-center gap-6">
			<div class={ "w-16 h-16 rounded-full flex items-center justify-center text-white text-2xl font-bold " + data.Engineer.AvatarColor }>
				{ getInitials(data.Engineer.Name) }
			</div>
			<div>
				<h2 class="text-2xl font-bold text-white">{ data.Engineer.Name }</h2>
				<p class="text-sm text-white">{ data.Engineer.Email }</p>
				<p class="text-sm text-cyan-200 mt-1">Sprint: { data.Sprint.Name }</p>
			</div>
		</div>
		<div class="flex items-center gap-4">
			<div class="text-right">
				<p class="text-xs text-cyan-200 mb-1">Sprint Period</p>
				<p class="text-sm font-semibold text-white">
					if data.Sprint.StartDate != "" {
						{ data.Sprint.StartDate } - { data.Sprint.EndDate }
					} else {
						-
					}
				</p>
			</div>
		</div>
	</div>

	<!-- Info Requests Section -->
	if data.Engineer.Email != "" {
		<div id="info-requests" class="glass rounded-2xl p-6 mb-8 animate-fade-in">
			<h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
				<span>📋</span>
				<span>Info Requests</span>
				<span class="text-xs text-cyan-200 font-normal ml-2">(Reply via Webex)</span>
			</h3>
			<div id="info-request-list" class="space-y-3">
				<p class="text-cyan-200 text-center py-4">Loading info requests...</p>
			</div>
		</div>
	}

	<!-- Stats Cards -->
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
		@components.StatsCard("Total Stories", data.Stats.TotalStories, "assigned", "📖", "from-blue-500 to-blue-600")
		@components.StatsCard("Completed", data.Stats.CompletedStories, "stories done", "✅", "from-green-500 to-green-600")
		@components.StatsCard("Story Points", data.Stats.StoryPoints, fmt.Sprintf("%d completed", data.Stats.CompletedPoints), "⚡", "from-purple-500 to-purple-600")
		@components.StatsCard("Defects", data.Stats.TotalDefects, fmt.Sprintf("%d resolved", data.Stats.ResolvedDefects), "🐛", "from-red-500 to-red-600")
	</div>

	<!-- Charts Row 1 -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
		@components.EngineerWorkDistribution(data.Stories, data.Defects)
		@components.StoryPointsProgress(data.Stats.CompletedPoints, data.Stats.StoryPoints)
	</div>

	<!-- Charts Row 2 -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
		@components.EngineerStoryStatusPieChart(data.Stories)
		@components.EngineerDefectStatusPieChart(data.Defects)
	</div>

	<!-- Stories Section -->
	<div class="mb-8">
		<h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
			<span>📖</span>
			<span>Stories ({ fmt.Sprintf("%d", len(data.Stories)) })</span>
		</h3>

		if len(data.Stories) > 0 {
			<div class="grid grid-cols-1 gap-4">
				for _, story := range data.Stories {
					@components.StoryCard(story)
				}
			</div>
		} else {
			<p class="text-cyan-200 text-center py-8">No stories assigned in this sprint</p>
		}
	</div>

	<!-- Defects Section -->
	<div class="mb-8">
		<h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
			<span>🐛</span>
			<span>Defects ({ fmt.Sprintf("%d", len(data.Defects)) })</span>
		</h3>

		if len(data.Defects) > 0 {
			<div class="grid grid-cols-1 gap-4">
				for _, defect := range data.Defects {
					@components.DefectCard(defect)
				}
			</div>
		} else {
			<p class="text-cyan-200 text-center py-8">No defects assigned in this sprint</p>
		}
	</div>
}

func getInitials(name string) string {
	if name == "" || name == "Select an Engineer" {
		return "?"
	}

	// Split name and get first letter of each word
	words := []rune(name)
	if len(words) > 0 {
		return string(words[0])
	}
	return "?"
}


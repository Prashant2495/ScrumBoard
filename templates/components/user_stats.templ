package components

import (
	"ScrumBoard/internal/models"
	"fmt"
)

templ UserStatsSection(userStats []models.UserStats) {
	<div class="glass rounded-2xl p-6 card-hover animate-fade-in">
		<h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
			<span class="text-xl">👥</span>
			Team Workload
		</h3>
		
		<div class="space-y-4">
			for _, us := range userStats {
				@UserStatRow(us)
			}
		</div>
	</div>
}

templ UserStatRow(us models.UserStats) {
	<div class="flex items-center justify-between p-3 bg-white/10 rounded-xl hover:bg-white/20 transition-all">
		<div class="flex items-center gap-3">
			<div class="w-10 h-10 rounded-full bg-gradient-to-br from-secondary-400 to-primary-500 flex items-center justify-center text-white font-semibold">
				{ getInitials(us.User.Name) }
			</div>
			<div>
				<p class="font-medium text-white">{ us.User.Name }</p>
				<p class="text-xs text-white">{ fmt.Sprintf("%d stories assigned", us.AssignedStories) }</p>
			</div>
		</div>

		<div class="flex items-center gap-4">
			<div class="text-center">
				<p class="text-lg font-bold text-white">{ fmt.Sprintf("%d", us.AssignedPoints) }</p>
				<p class="text-xs text-white">Points</p>
			</div>
			<div class="text-center">
				<p class="text-lg font-bold text-green-400">{ fmt.Sprintf("%d", us.CompletedPoints) }</p>
				<p class="text-xs text-white">Done</p>
			</div>
			<div class="w-20">
				<div class="w-full bg-white/20 rounded-full h-2">
					<div 
						class="h-full rounded-full bg-gradient-to-r from-primary-400 to-primary-600"
						style={ fmt.Sprintf("width: %d%%", getUserProgress(us)) }
					></div>
				</div>
			</div>
		</div>
	</div>
}

func getUserProgress(us models.UserStats) int {
	if us.AssignedPoints == 0 {
		return 0
	}
	return (us.CompletedPoints * 100) / us.AssignedPoints
}


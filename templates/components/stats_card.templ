package components

import "fmt"

templ StatsCard(title string, value int, subtitle string, icon string, colorClass string) {
	<div class={ "glass rounded-2xl p-6 card-hover animate-scale-in shadow-lg hover:shadow-2xl " + colorClass }>
		<div class="flex items-center justify-between">
			<div>
				<p class="text-sm font-semibold text-slate-500 uppercase tracking-wide">{ title }</p>
				<p class="text-4xl font-extrabold text-slate-800 mt-2 transition-all duration-300">{ fmt.Sprintf("%d", value) }</p>
				<p class="text-sm text-slate-600 mt-1 font-medium">{ subtitle }</p>
			</div>
			<div class={ "w-16 h-16 rounded-2xl flex items-center justify-center text-3xl shadow-md transition-transform duration-300 hover:scale-110 " + getIconBg(colorClass) }>
				{ icon }
			</div>
		</div>
	</div>
}

func getIconBg(colorClass string) string {
	switch colorClass {
	case "border-l-4 border-primary-500":
		return "bg-primary-100 text-primary-600"
	case "border-l-4 border-secondary-500":
		return "bg-secondary-100 text-secondary-600"
	case "border-l-4 border-amber-500":
		return "bg-amber-100 text-amber-600"
	case "border-l-4 border-emerald-500":
		return "bg-emerald-100 text-emerald-600"
	default:
		return "bg-slate-100 text-slate-600"
	}
}

templ ProgressBar(completed int, total int) {
	<div class="glass rounded-2xl p-6 card-hover animate-slide-left shadow-lg">
		<div class="flex items-center justify-between mb-4">
			<h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
				<span class="text-2xl">🚀</span>
				<span>Sprint Progress</span>
			</h3>
			<span class={ "text-3xl font-extrabold " + getProgressTextColor(getPercentage(completed, total)) }>
				{ fmt.Sprintf("%d%%", getPercentage(completed, total)) }
			</span>
		</div>
		<div class="w-full bg-slate-200 rounded-lg h-8 overflow-hidden shadow-inner relative">
			<div
				class={ "h-full rounded-lg transition-all duration-1000 ease-out relative " + getProgressBarColor(getPercentage(completed, total)) }
				style={ fmt.Sprintf("width: %d%%", getPercentage(completed, total)) }
			>
				<div class="absolute inset-0 flex items-center justify-center">
					<span class="text-white font-bold text-sm drop-shadow-lg">
						{ fmt.Sprintf("%d / %d pts", completed, total) }
					</span>
				</div>
			</div>
		</div>
		<div class="flex justify-between mt-4 text-sm font-semibold text-slate-600">
			<span>✅ { fmt.Sprintf("%d points completed", completed) }</span>
			<span>🎯 { fmt.Sprintf("%d points total", total) }</span>
		</div>
	</div>
}

func getPercentage(completed, total int) int {
	if total == 0 {
		return 0
	}
	return (completed * 100) / total
}

func getProgressBarColor(percentage int) string {
	if percentage < 30 {
		return "bg-gradient-to-r from-red-500 to-red-600"
	} else if percentage < 50 {
		return "bg-gradient-to-r from-orange-500 to-orange-600"
	} else if percentage < 70 {
		return "bg-gradient-to-r from-yellow-500 to-yellow-600"
	} else if percentage < 90 {
		return "bg-gradient-to-r from-blue-500 to-blue-600"
	} else {
		return "bg-gradient-to-r from-green-500 to-green-600"
	}
}

func getProgressTextColor(percentage int) string {
	if percentage < 30 {
		return "text-red-600"
	} else if percentage < 50 {
		return "text-orange-600"
	} else if percentage < 70 {
		return "text-yellow-600"
	} else if percentage < 90 {
		return "text-blue-600"
	} else {
		return "text-green-600"
	}
}


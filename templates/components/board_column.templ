package components

import (
	"ScrumBoard/internal/models"
	"fmt"
)

templ BoardColumn(title string, stories []models.Story, colorClass string, icon string) {
	<div class="flex-1 min-w-[300px]">
		<div class={ "rounded-2xl p-4 " + colorClass }>
			<div class="flex items-center justify-between mb-4">
				<div class="flex items-center gap-2">
					<span class="text-xl">{ icon }</span>
					<h3 class="font-semibold text-white">{ title }</h3>
				</div>
				<span class="bg-white/20 text-white text-sm font-semibold px-3 py-1 rounded-full">
					{ fmt.Sprintf("%d", len(stories)) }
				</span>
			</div>
			
			<div class="space-y-3 max-h-[600px] overflow-y-auto pr-2">
				for _, story := range stories {
					@StoryCard(story)
				}
				
				if len(stories) == 0 {
					<div class="text-center py-8 text-white/60">
						<p class="text-4xl mb-2">📭</p>
						<p class="text-sm">No stories here</p>
					</div>
				}
			</div>
		</div>
	</div>
}

templ SprintBoard(todo, inProgress, done []models.Story) {
	<div class="mt-8 animate-fade-in">
		<h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
			<span class="text-2xl">📋</span>
			Sprint Board
		</h2>
		
		<div class="flex gap-6 overflow-x-auto pb-4">
			@BoardColumn("To Do", todo, "bg-slate-100/80", "📝")
			@BoardColumn("In Progress", inProgress, "bg-blue-500/30/80", "🔄")
			@BoardColumn("Done", done, "bg-green-500/30/80", "✅")
		</div>
	</div>
}


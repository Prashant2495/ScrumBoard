package components

import (
	"ScrumBoard/internal/models"
	"fmt"
)

templ DefectCard(defect models.Defect) {
	<div class="glass rounded-xl p-4 hover:shadow-lg transition-all animate-fade-in border-l-4 { getSeverityBorderClass(defect.Severity) }">
		<!-- Header -->
		<div class="flex items-start justify-between mb-3">
			<div class="flex-1">
				<div class="flex items-center gap-2 mb-1">
					<span class="text-xs font-mono text-cyan-200">{ defect.Key }</span>
					@SeverityBadge(defect.Severity)
					@PriorityBadge(defect.Priority)
				</div>
				<h3 class="font-semibold text-white text-sm leading-tight">
					{ defect.Summary }
				</h3>
			</div>
		</div>

		<!-- Metadata -->
		<div class="flex items-center gap-4 text-xs text-cyan-200 mb-3">
			if defect.Environment != "" {
				<div class="flex items-center gap-1">
					<span>🌍</span>
					<span>{ defect.Environment }</span>
				</div>
			}
			<div class="flex items-center gap-1">
				<span>📅</span>
				<span>{ fmt.Sprintf("%dd old", defect.AgeInDays) }</span>
			</div>
			if defect.ResolutionTime > 0 {
				<div class="flex items-center gap-1">
					<span>⏱️</span>
					<span>{ fmt.Sprintf("%dh to resolve", defect.ResolutionTime) }</span>
				</div>
			}
		</div>

		<!-- Assignee & Request Info -->
		if defect.Assignee.Name != "" {
			<div class="flex items-center justify-between pt-2 border-t border-slate-200">
				<div class="flex items-center gap-2">
					<div class="w-6 h-6 rounded-full bg-gradient-to-br from-primary-400 to-secondary-400 flex items-center justify-center text-white text-xs font-semibold">
						{ string([]rune(defect.Assignee.Name)[0]) }
					</div>
					<span class="text-xs text-cyan-200">{ defect.Assignee.Name }</span>
				</div>
				if defect.Assignee.Email != "" {
					<button
						class="request-info-btn px-2 py-1 bg-orange-500 hover:bg-orange-600 text-white text-xs font-semibold rounded-lg transition-all shadow-sm"
						data-email={ defect.Assignee.Email }
						data-name={ defect.Assignee.Name }
						data-item-key={ defect.Key }
						data-item-title={ defect.Summary }
						data-item-type="defect"
						title="Request info via Webex"
					>
						📋
					</button>
				}
			</div>
		}
	</div>
}

templ SeverityBadge(severity string) {
	<span class={ "px-2 py-0.5 rounded-full text-xs font-semibold " + getSeverityClass(severity) }>
		{ severity }
	</span>
}

templ PriorityBadge(priority string) {
	<span class={ "px-2 py-0.5 rounded-full text-xs font-medium " + getDefectPriorityClass(priority) }>
		{ priority }
	</span>
}

func getSeverityClass(severity string) string {
	switch severity {
	case "Critical":
		return "bg-red-500/30 text-red-300"
	case "High":
		return "bg-orange-500/30 text-orange-300"
	case "Medium":
		return "bg-yellow-500/30 text-yellow-300"
	case "Low":
		return "bg-green-500/30 text-green-300"
	default:
		return "bg-white/20 text-cyan-200"
	}
}

func getSeverityBorderClass(severity string) string {
	switch severity {
	case "Critical":
		return "border-red-400"
	case "High":
		return "border-orange-400"
	case "Medium":
		return "border-yellow-400"
	case "Low":
		return "border-green-400"
	default:
		return "border-white/30"
	}
}

func getDefectPriorityClass(priority string) string {
	switch priority {
	case "Blocker", "Highest":
		return "bg-purple-500/30 text-purple-300"
	case "Critical", "High":
		return "bg-red-500/30 text-red-300"
	case "Major", "Medium":
		return "bg-blue-500/30 text-blue-300"
	case "Minor", "Low":
		return "bg-white/20 text-cyan-200"
	default:
		return "bg-white/20 text-white/60"
	}
}

